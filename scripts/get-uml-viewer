#!/bin/zsh
# Fetch uml-viewer into this project and start it.
# Install: curl -fsSL https://raw.githubusercontent.com/johnkabler/uml-viewer/master/scripts/get-uml-viewer -o get-uml-viewer
#          chmod +x get-uml-viewer && ./get-uml-viewer --install-only
set -euo pipefail

repo_url="${UML_VIEWER_REPO_URL:-https://github.com/johnkabler/uml-viewer.git}"
ref="${UML_VIEWER_REF:-master}"
tool_dir=".uml-viewer/uml-viewer"
quil_ver="4.3.1563"

usage() {
  echo "usage: get-uml-viewer [--install-only]" >&2
  echo "  Run from the project you want to view. Clones uml-viewer into" >&2
  echo "  gitignored ${tool_dir}/, writes ./uml, then starts the viewer." >&2
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

install_only=0
if [[ "${1:-}" == "--install-only" ]]; then
  install_only=1
elif [[ $# -gt 0 ]]; then
  usage
  exit 1
fi

if ! command -v git >/dev/null; then
  echo "get-uml-viewer: git is required" >&2
  exit 1
fi

ensure_gitignore() {
  local file=".gitignore"
  local begin="# BEGIN UML-VIEWER"
  local end="# END UML-VIEWER"
  local tmp_file
  tmp_file="$(mktemp)"
  touch "$file"
  awk -v begin="$begin" -v end="$end" '
    $0 == begin { inside=1; next }
    $0 == end { inside=0; next }
    !inside { print }
  ' "$file" > "$tmp_file"
  [[ ! -s "$tmp_file" ]] || printf '\n' >> "$tmp_file"
  printf '%s\n' "$begin" ".uml-viewer/" "/uml" "$end" >> "$tmp_file"
  mv "$tmp_file" "$file"
}

fetch_tool() {
  mkdir -p .uml-viewer
  if [[ -d "$tool_dir/.git" ]]; then
    git -C "$tool_dir" fetch --depth 1 origin "$ref"
    git -C "$tool_dir" checkout -q FETCH_HEAD
  else
    rm -rf "$tool_dir"
    git clone --depth 1 --branch "$ref" "$repo_url" "$tool_dir"
  fi
}

install_analyzers() {
  if command -v poetry >/dev/null; then
    poetry -C "$tool_dir/analyzers/python" install --no-interaction
  else
    echo "get-uml-viewer: poetry is required to scan Python projects" >&2
  fi
  if command -v npm >/dev/null; then
    npm --prefix "$tool_dir/analyzers/typescript" install --silent
  else
    echo "get-uml-viewer: npm is required to scan TypeScript projects" >&2
  fi
}

write_uml() {
  local abs deps
  abs="$(cd "$tool_dir" && pwd)"
  deps="{:deps {uml-viewer/uml-viewer {:local/root \"$abs\"} quil/quil {:mvn/version \"$quil_ver\"}}}"
  sed -e "s|__DEPS_LINE__|${deps}|" -e "s|__TOOL_HOME__|${abs}|" \
    "$tool_dir/scripts/uml" > ./uml
  chmod +x ./uml
}

ensure_gitignore
fetch_tool
install_analyzers
write_uml

echo "Installed ./uml (uml-viewer in $tool_dir)."
if [[ "$install_only" -eq 1 ]]; then
  echo "Run ./uml to start the viewer."
  exit 0
fi

exec ./uml
